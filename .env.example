# Public site (Vite) — also add these in Vercel → Environment Variables
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Vercel serverless only (Settings → Environment Variables). NEVER use VITE_ prefix.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Seed script only (local). NEVER commit.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SEED_SUPER_EMAIL=you@example.com
# SEED_SUPER_PASSWORD=choose-a-strong-password
# SEED_ADMIN_EMAIL=client@example.com
# SEED_ADMIN_PASSWORD=choose-a-strong-password
